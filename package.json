{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "format": "prettier --write .",
    "db:seed": "bun run ./api/seed/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate"

  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "jiti": "^2.7.0",
    "prettier": "^3.9.7"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
